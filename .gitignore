__pycache__/
*.pyc
.venv/
.env
.env.*
!.env.example

# Local scratch SQLite ledgers stay local. The committed 30-day experiment
# ledger (state/experiment.sqlite3) is whitelisted so each stateless GitHub
# Actions run can load prior state; its JSON projections in state/ are tracked
# normally, as are logs/ and trades/.
*.sqlite3
*.sqlite3-*
!state/experiment.sqlite3

# Private runtime evidence and host inventory remain local.
evidence/*
!evidence/README.md
docs/environment.md
*.pem
*.key
*.p12
*.pfx
.DS_Store
