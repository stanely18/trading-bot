{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading-poc:agent-output:1",
  "title": "Structured trade proposal returned by the trading agent (e.g. Kimi K3).",
  "description": "The model returns market assessment and ranked candidates only. It never sizes orders in USDT and never triggers execution; the deterministic Python risk engine computes notionals and approves, resizes or rejects each candidate.",
  "type": "object",
  "properties": {
    "market_regime": {
      "enum": ["risk_on", "risk_off", "neutral", "high_volatility", "unclear"]
    },
    "portfolio_view": {
      "enum": ["add_risk", "reduce_risk", "neutral", "rotate"]
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "enum": ["BTC-USDT", "ETH-USDT", "SOL-USDT", "BNB-USDT", "XRP-USDT"]
          },
          "action": {
            "enum": ["BUY", "SELL", "HOLD", "CLOSE"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "target_allocation": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Desired fraction of NAV in this position. Advisory only; Python clamps to policy caps."
          },
          "thesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "invalidation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "risk_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        "required": [
          "symbol",
          "action",
          "confidence",
          "target_allocation",
          "thesis",
          "invalidation",
          "risk_notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["market_regime", "portfolio_view", "candidates"],
  "additionalProperties": false
}
