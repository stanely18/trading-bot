{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading-poc:proposal:1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "created_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "action": {
      "enum": [
        "HOLD",
        "BUY",
        "SELL"
      ]
    },
    "symbol": {
      "enum": [
        "BTC-USDT",
        "ETH-USDT",
        "SOL-USDT"
      ]
    },
    "notional": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "id",
    "created_ms",
    "expected_revision",
    "agent",
    "action",
    "symbol",
    "notional",
    "reason"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "HOLD"
          }
        }
      },
      "then": {
        "properties": {
          "notional": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "notional": {
            "exclusiveMinimum": 0
          }
        }
      }
    }
  ]
}
