{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trading-poc:run:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "recorded_ms": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "const": "paper"
    },
    "proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "created_ms": {
          "type": "integer",
          "minimum": 0
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "action": {
          "enum": [
            "HOLD",
            "BUY",
            "SELL"
          ]
        },
        "symbol": {
          "enum": [
            "BTC-USDT",
            "ETH-USDT",
            "SOL-USDT"
          ]
        },
        "notional": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "created_ms",
        "expected_revision",
        "agent",
        "action",
        "symbol",
        "notional",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "HOLD"
              }
            }
          },
          "then": {
            "properties": {
              "notional": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "notional": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "market": {
      "type": "object",
      "properties": {
        "BTC-USDT": {
          "type": "object",
          "properties": {
            "symbol": {
              "enum": [
                "BTC-USDT",
                "ETH-USDT",
                "SOL-USDT"
              ]
            },
            "price": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ts_ms": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "enum": [
                "okx_public",
                "fixture"
              ]
            }
          },
          "required": [
            "symbol",
            "price",
            "ts_ms",
            "source"
          ],
          "additionalProperties": false
        },
        "ETH-USDT": {
          "type": "object",
          "properties": {
            "symbol": {
              "enum": [
                "BTC-USDT",
                "ETH-USDT",
                "SOL-USDT"
              ]
            },
            "price": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ts_ms": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "enum": [
                "okx_public",
                "fixture"
              ]
            }
          },
          "required": [
            "symbol",
            "price",
            "ts_ms",
            "source"
          ],
          "additionalProperties": false
        },
        "SOL-USDT": {
          "type": "object",
          "properties": {
            "symbol": {
              "enum": [
                "BTC-USDT",
                "ETH-USDT",
                "SOL-USDT"
              ]
            },
            "price": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ts_ms": {
              "type": "integer",
              "minimum": 0
            },
            "source": {
              "enum": [
                "okx_public",
                "fixture"
              ]
            }
          },
          "required": [
            "symbol",
            "price",
            "ts_ms",
            "source"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "BTC-USDT",
        "ETH-USDT",
        "SOL-USDT"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "held",
        "filled",
        "rejected"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "fills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "enum": [
              "BTC-USDT",
              "ETH-USDT",
              "SOL-USDT"
            ]
          },
          "side": {
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "qty": {
            "type": "number",
            "minimum": 0
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "fee": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "symbol",
          "side",
          "qty",
          "price",
          "fee",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "equity": {
      "type": "number",
      "minimum": 0
    },
    "previous_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "recorded_ms",
    "revision",
    "mode",
    "proposal",
    "market",
    "status",
    "reason",
    "fills",
    "equity",
    "previous_hash",
    "hash"
  ],
  "additionalProperties": false
}
